#!/bin/sh
# set -u
function error () { printf >&2 "%s\n\nPlease see README.md for build instructions.\n" "$1"; exit 1; }

# ===============================
# = Check required dependencies =
# ===============================

for dep in capnp ninja ragel multimarkdown pgrep pkill; do
	which -s "$dep" || error "*** dependency missing: ‘${dep}’."
done

if [[ -e local.rave ]]; then
	echo >&2 "Skipping writing ‘local.rave’: File already exists"
else
	prefix=$(brew --prefix 2>/dev/null)
	if [[ -z "$prefix" ]]; then
		for dir in /opt/homebrew /opt/local /usr/local; do
			if [[ -d "$dir/include" ]]; then prefix="$dir"; break; fi
		done
	fi
	test -n "$prefix" || error "*** unable to locate Homebrew or MacPorts prefix. Create ‘local.rave’ manually with include/library paths."

	for hdr in capnp/{message,serialize-packed}.h; do
		test -f "${prefix}/include/${hdr}" || error "*** dependency missing: ‘${prefix}/include/${hdr}’. Install dependency and/or update ‘local.rave’ with correct path."
	done

	for lib in capnp kj; do
		ls "${prefix}/lib/lib${lib}."* >/dev/null 2>&1 || error "*** dependency missing: ‘${prefix}/lib/lib${lib}.*’. Install dependency and/or update ‘local.rave’ with correct path."
	done

	echo >> local.rave "add FLAGS    \"-I${prefix}/include\""
	echo >> local.rave "add LN_FLAGS \"-L${prefix}/lib\""
fi

# ========================
# = Generate build files =
# ========================

if [[ -d "$builddir" ]];
	then bin/rave -crelease -tTextMate -b"$builddir"
	else bin/rave -crelease -tTextMate
fi
